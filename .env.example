DATABASE_URL=postgresql://realestate_user:realestate_password@localhost:5432/real_estate_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
TAVILY_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string
# GROQ_API_KEY=

# --- Property photo storage (Supabase Storage) ---
# Leave these unset to fall back to saving uploads on local disk (only
# visible from whichever machine's backend received the upload) — fine for
# solo use, but photos won't be visible to anyone sharing your database.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=property-images

# --- SMS notifications (Interested flow texts both broker & buyer) ---
# Leave SMS_PROVIDER unset to keep SMS dormant (messages are only logged).
# SMS_PROVIDER=twilio
# SMS_DEFAULT_COUNTRY_CODE=+91
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
